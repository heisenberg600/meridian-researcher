# Copy this file to evals/.env and fill in real values. evals/.env is gitignored.

# From laminar.sh -> your project -> Evaluations -> "Generate"
LMNR_PROJECT_API_KEY=

# The Vercel AI Gateway key the Meridian app already uses (Convex env: AI_GATEWAY_API_KEY).
# Lets the eval actually call Meridian's interviewer/strategist model.
AI_GATEWAY_API_KEY=
