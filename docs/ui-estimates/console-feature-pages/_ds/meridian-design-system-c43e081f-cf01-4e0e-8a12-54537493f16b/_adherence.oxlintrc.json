        "selector": "JSXOpeningElement[name.name='VoiceAgentBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|duration|muted|onMute|onEnd|style|key|ref|className|style|children)$/]",
        "message": "<VoiceAgentBar> doesn't accept that prop. Declared props: status, duration, muted, onMute, onEnd, style."
      }
