{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/ai/**",
              "components/commerce/**",
              "components/display/**",
              "components/feedback/**",
              "components/forms/**",
              "components/hitl/**",
              "components/navigation/**",
              "ui_kits/console/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Source Serif 4|Instrument Sans|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Source Serif 4, Instrument Sans, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActivityItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|title|detail|project|time|unread|action|onAction|style|key|ref|className|style|children)$/]",
        "message": "<ActivityItem> doesn't accept that prop. Declared props: kind, title, detail, project, time, unread, action, onAction, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActivityItem'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:input|research|form|call|system)$/]",
        "message": "<ActivityItem> kind must be one of 'input' | 'research' | 'form' | 'call' | 'system'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgentStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:agent|detail|state|handoffFrom|time|key|ref|className|style|children)$/]",
        "message": "<AgentStep> doesn't accept that prop. Declared props: agent, detail, state, handoffFrom, time."
      },
      {
        "selector": "JSXOpeningElement[name.name='AgentStep'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:done|working|waiting|queued)$/]",
        "message": "<AgentStep> state must be one of 'done' | 'working' | 'waiting' | 'queued'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ApprovalCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|meta|status|approveLabel|declineLabel|onApprove|onDecline|resolvedNote|children|style|key|ref|className|style|children)$/]",
        "message": "<ApprovalCard> doesn't accept that prop. Declared props: title, description, meta, status, approveLabel, declineLabel, onApprove, onDecline, resolvedNote, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ApprovalCard'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:pending|approved|declined)$/]",
        "message": "<ApprovalCard> status must be one of 'pending' | 'approved' | 'declined'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|dot|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, dot, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|success|warning|danger|info)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'accent' | 'success' | 'warning' | 'danger' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|iconLeft|children|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, iconLeft, children, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CanvasPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|kind|onCopy|onDownload|onClose|footerHint|toolbar|width|children|style|key|ref|className|style|children)$/]",
        "message": "<CanvasPanel> doesn't accept that prop. Declared props: title, meta, kind, onCopy, onDownload, onClose, footerHint, toolbar, width, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CanvasPanel'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:file|sheet)$/]",
        "message": "<CanvasPanel> kind must be one of 'file' | 'sheet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|action|padded|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: title, action, padded, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatComposer'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|attachments|onSend|onAttach|onVoice|voiceActive|toolbar|style|key|ref|className|style|children)$/]",
        "message": "<ChatComposer> doesn't accept that prop. Declared props: placeholder, attachments, onSend, onAttach, onVoice, voiceActive, toolbar, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatMessage'] > JSXAttribute > JSXIdentifier[name!=/^(?:role|author|time|sources|children|style|key|ref|className|style|children)$/]",
        "message": "<ChatMessage> doesn't accept that prop. Declared props: role, author, time, sources, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatMessage'] > JSXAttribute[name.name='role'] > Literal[value!=/^(?:user|assistant)$/]",
        "message": "<ChatMessage> role must be one of 'user' | 'assistant'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|defaultChecked|disabled|onChange|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, checked, defaultChecked, disabled, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='CreditBalance'] > JSXAttribute > JSXIdentifier[name!=/^(?:balance|unit|usedThisMonth|refreshNote|low|onAdd|addLabel|style|key|ref|className|style|children)$/]",
        "message": "<CreditBalance> doesn't accept that prop. Declared props: balance, unit, usedThisMonth, refreshNote, low, onAdd, addLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DecisionOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|key|ref|className|style|children)$/]",
        "message": "<DecisionOption> doesn't accept that prop. Declared props: id, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|title|footer|width|children|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, onClose, title, footer, width, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|children|onClick|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: variant, size, disabled, children, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ghost|secondary)$/]",
        "message": "<IconButton> variant must be one of 'ghost' | 'secondary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|placeholder|value|disabled|type|onChange|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, error, placeholder, value, disabled, type, onChange."
      },
      {
