        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|options|value|disabled|onChange|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, options, value, disabled, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='SheetGrid'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|rows|selected|onSelect|style|key|ref|className|style|children)$/]",
        "message": "<SheetGrid> doesn't accept that prop. Declared props: columns, rows, selected, onSelect, style."
