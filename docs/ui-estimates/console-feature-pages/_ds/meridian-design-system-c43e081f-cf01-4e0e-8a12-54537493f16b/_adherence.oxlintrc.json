        "message": "<PaymentMethodRow> doesn't accept that prop. Declared props: brand, last4, expiry, isDefault, onRemove, onMakeDefault, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PdfPage'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|of|children|style|key|ref|className|style|children)$/]",
        "message": "<PdfPage> doesn't accept that prop. Declared props: number, of, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Radio'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|disabled|onChange|key|ref|className|style|children)$/]",
        "message": "<Radio> doesn't accept that prop. Declared props: label, checked, disabled, onChange."
      },
