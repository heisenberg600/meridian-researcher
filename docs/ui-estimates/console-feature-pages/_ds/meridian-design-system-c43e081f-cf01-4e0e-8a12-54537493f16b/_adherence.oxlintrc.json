      {
        "selector": "JSXOpeningElement[name.name='SourceChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|meta|kind|onRemove|style|key|ref|className|style|children)$/]",
        "message": "<SourceChip> doesn't accept that prop. Declared props: name, meta, kind, onRemove, style."
