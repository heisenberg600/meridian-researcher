{
  "name": "meridian",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:frontend": "vite",
    "convex:dev": "convex dev",
    "convex:codegen": "convex codegen",
    "convex:deploy": "convex deploy",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "pnpm test:unit && pnpm test:backend",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:backend": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "deploy:cloudflare": "pnpm run build && wrangler pages deploy dist --project-name hermes-researcher --branch main --force",
    "lint": "eslint",
    "eval:interviewer": "lmnr eval evals/interviewer.eval.ts",
    "eval:strategist": "lmnr eval evals/strategist.eval.ts",
    "elevenlabs:provision": "node scripts/provision-elevenlabs-agent.mjs --set-convex-env"
  },
