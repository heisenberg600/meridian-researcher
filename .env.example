# Generated by `convex dev`; keep the real values in `.env.local`.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CLERK_PUBLISHABLE_KEY=
# Server-side OpenAI access used by Meridian, questionnaires, interviews, analysis, and knowledge processing.
OPENAI_API_KEY=

# ElevenLabs Conversational AI agent used by the public voice interview.
# Set these on the Convex deployment with:
# pnpm exec convex env set ELEVENLABS_API_KEY <value>
# pnpm exec convex env set ELEVENLABS_AGENT_ID <agent_id>
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Clerk Dashboard → API keys
CLERK_SECRET_KEY=

# Clerk Dashboard → Convex integration → Frontend API URL.
# Set this on the Convex deployment with:
# pnpm exec convex env set CLERK_JWT_ISSUER_DOMAIN <value>
CLERK_JWT_ISSUER_DOMAIN=

# Dodo Payments Test Mode only. Keep secrets in .env.local and Convex deployment env.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_CHECKOUT_RETURN_URL=
DODO_PRODUCT_CREDITS_1M=
DODO_PRODUCT_CREDITS_3M=
DODO_PRODUCT_CREDITS_10M=
